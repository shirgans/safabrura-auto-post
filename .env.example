# Google Drive
# Drive folder to watch. Subfolders are searched too (Google Meet nests
# recordings in per-event "... (recurring)" folders). Comma-separate for several roots.
GOOGLE_DRIVE_FOLDER_ID=your_folder_id
GOOGLE_SERVICE_ACCOUNT_FILE=path/to/service-account.json
# Optional: Workspace user to impersonate via domain-wide delegation. When set,
# the whole of that user's Drive is visible without sharing folders one by one,
# so GOOGLE_DRIVE_FOLDER_ID can simply be 'root'.
GOOGLE_IMPERSONATE_USER=

# AWS S3
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_S3_BUCKET=your_bucket_name
AWS_S3_REGION=your_region

# WordPress
WORDPRESS_URL=https://safabrura.com
WORDPRESS_USERNAME=your_username
WORDPRESS_APP_PASSWORD=your_app_password

# Captivate.fm
CAPTIVATE_API_USER_ID=your_user_id
CAPTIVATE_API_TOKEN=your_token
CAPTIVATE_SHOW_ID=your_show_id

# Local
TEMP_DOWNLOAD_PATH=./temp
FFMPEG_PATH=ffmpeg
